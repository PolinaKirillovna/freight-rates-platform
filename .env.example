# Значения по умолчанию уже прописаны в docker-compose.yml. Чтобы переопределить: cp .env.example .env

# --- PostgreSQL 17: сервер с базами источника (deals_bigdata) и хранилища (dwh)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres
POSTGRES_PORT_HOST=5432
SOURCE_N_PRICES=300000

SOURCE_DB_USER=source_reader
SOURCE_DB_PASSWORD=change-me-source
DWH_DB_USER=dwh
DWH_DB_PASSWORD=change-me-dwh
BI_DB_USER=bi_reader
BI_DB_PASSWORD=change-me-bi

# --- параметры конвейера
AS_OF_DATE=2026-10-26
PIPELINE_START_DATE=2023-01-01
PIPELINE_END_DATE=2027-12-31
PIPELINE_LOOKBACK_DAYS=14
PIPELINE_FORWARD_DAYS=150
RANDOM_SEED=42
LOG_LEVEL=INFO

# --- ClickHouse
CLICKHOUSE_ENABLED=true
CLICKHOUSE_DB=freight
CLICKHOUSE_USER=freight
CLICKHOUSE_PASSWORD=change-me-clickhouse
CLICKHOUSE_HTTP_PORT_HOST=8123

# --- Superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=change-me-superset-db
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_PORT_HOST=8088

# --- Airflow (профиль airflow)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-airflow-db
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_PORT_HOST=8080
AIRFLOW_FERNET_KEY=
